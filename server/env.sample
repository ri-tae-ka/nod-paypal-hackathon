PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Atlas connection string, including the database name (procurement_desk)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/procurement_desk?retryWrites=true&w=majority
# Session signing key, at least 32 chars. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=<random-string-at-least-32-chars>
# Optional: bcrypt cost factor (4-15, default 12)
# BCRYPT_ROUNDS=12
# Channel3 product search (https://trychannel3.com). Search returns 503 until set.
CHANNEL3_API_KEY=<your-channel3-api-key>
# Optional: max Channel3 calls per user per UTC day (cache hits are free, default 50)
# CHANNEL3_DAILY_SEARCH_LIMIT=50
# Gemini API key (free tier: https://aistudio.google.com/apikey). AI generation returns 503 until set.
GEMINI_API_KEY=<your-gemini-api-key>
# Optional: model id; must support JSON mode with a response schema (default gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
# PayPal Sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox). Checkout returns 503 until set.
PAYPAL_CLIENT_ID=<your-sandbox-client-id>
PAYPAL_CLIENT_SECRET=<your-sandbox-client-secret>
# Optional: max AI generations per user per UTC day (default 20)
# AI_DAILY_GENERATION_LIMIT=20
